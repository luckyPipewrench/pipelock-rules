{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/luckyPipewrench/pipelock-rules/compatibility/pipelock-rules-format-v1.schema.json",
  "title": "Pipelock rule bundle format 1 compatibility identity",
  "description": "The required header shape for the Pipelock format_version: 1 reader. This identity is intentionally separate from a bundle so published signed bytes do not change merely to record a tested engine ceiling.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "name",
    "version",
    "author",
    "description",
    "min_pipelock",
    "license",
    "rules"
  ],
  "properties": {
    "format_version": { "const": 1 },
    "name": { "type": "string" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "author": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "homepage": { "type": "string" },
    "min_pipelock": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "license": { "type": "string", "minLength": 1 },
    "tier": { "type": "string" },
    "monotonic_version": { "type": "integer", "minimum": 1 },
    "published_at": { "type": "string" },
    "expires_at": { "type": "string" },
    "required_features": { "type": "array" },
    "key_id": { "type": "string" },
    "rules": { "type": "array" }
  }
}
